{
  "manifest_version": 3,
  "name": "Artlist Relay & Asset Dispatcher",
  "version": "1.4.0",
  "description": "Local relay for Artlist licensing: queue, dedup cache, and library delivery.",
  "permissions": [
    "alarms",
    "downloads",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.artlist.io/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.artlist.io/*"
      ],
      "js": [
        "selectors.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Artlist Relay Active"
  }
}
